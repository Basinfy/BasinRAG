# BasinRAG / Basinfy configuration
# Copy this file to .env for local development. Explicit constructor/CLI
# arguments override process environment, which overrides .env and defaults.

# Required for API startup except explicit local development mode below.
BASINRAG_API_KEY=

# Keyless mode additionally requires BASINRAG_ALLOW_KEYLESS_LOCAL=true
# and a loopback bind. Use local_dev only on a developer workstation.
BASINRAG_ENV=production
BASINRAG_ALLOW_KEYLESS_LOCAL=false

# Comma-separated origins. Use only trusted frontend origins in production.
BASINRAG_CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Default LLM Provider (ollama | openai)
BASINRAG_LLM_PROVIDER=ollama

# Default LLM Model Name
BASINRAG_LLM_MODEL=qwen2.5

# Default encoder and reranker; changing the encoder requires reindexing.
BASINRAG_ENCODER_MODEL=BAAI/bge-base-en-v1.5
BASINRAG_ENCODER_REVISION=dd9f42942e0729b6c53632f3c23b0e801f236569
BASINRAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
BASINRAG_RERANKER_REVISION=c4b98d26050227d7b53a54437302be5aa412b70e

# Storage directory for graph and indices
BASINRAG_STORAGE_DIR=.basinrag-v3

# Retrieval and ranking
BASINRAG_SEARCH_TYPE=auto
BASINRAG_RANKING_MODE=hybrid_rrf
BASINRAG_USE_RERANK=true
BASINRAG_MIN_CONFIDENCE=0.15

# Legacy chunk settings use characters; token settings are additive and optional.
BASINRAG_CHUNK_SIZE=512
BASINRAG_CHUNK_OVERLAP=128
# BASINRAG_CHUNK_SIZE_TOKENS=384
# BASINRAG_CHUNK_OVERLAP_TOKENS=32
BASINRAG_EMBEDDING_BATCH_SIZE=64
BASINRAG_CONTEXT_WINDOW_TOKENS=8192
BASINRAG_GENERATION_RESERVE_TOKENS=1024

# L3 is disabled by default; remote excerpt egress requires both flags.
BASINRAG_ENABLE_BACKGROUND_L3=false
BASINRAG_ALLOW_REMOTE_L3_EGRESS=false
BASINRAG_BM25_STEMMING=false

# Custom models require explicit immutable 40-character commit SHAs.
# BASINRAG_LLM_REVISION=<provider-model-revision>
# Optional explicit encoding override for ambiguous source files.
# BASINRAG_SOURCE_ENCODING=windows-1252
# Forwarded IPs affect rate limiting only when peer is in these networks.
# BASINRAG_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# BGE query instruction used by the default encoder.
BASINRAG_QUERY_PROMPT="Represent this sentence for searching relevant passages: "
