# BasinRAG Configuration Environment Variables

# API Key for REST API & WebSocket authentication (optional)
BASINRAG_API_KEY=your_secure_api_key_here

# Default LLM Provider (ollama | openai)
BASINRAG_LLM_PROVIDER=ollama

# Default LLM Model Name
BASINRAG_LLM_MODEL=qwen2.5

# Default Embedding Model
BASINRAG_ENCODER_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Storage directory for graph and indices
BASINRAG_STORAGE_DIR=.basinrag
